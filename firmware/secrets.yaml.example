# Copiá este archivo a firmware/secrets.yaml y completá con tus valores.
# secrets.yaml está en .gitignore — NUNCA lo commitees.

wifi_ssid: "TU_RED_WIFI"
wifi_password: "TU_PASSWORD_WIFI"

# Generá una clave nueva en https://esphome.io/components/api.html (botón "generate key")
api_encryption_key: "BASE64_KEY_DE_32_BYTES="

ota_password: "una-clave-larga-para-OTA"
fallback_ap_password: "clave-del-AP-de-respaldo"
